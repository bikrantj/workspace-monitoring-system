<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      fx:controller="com.bikrantj.client.controllers.WorkspaceController"
      spacing="20"
>

    <padding>
        <Insets top="30" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Workspace title -->
    <Label fx:id="workspaceLabel"
           text="Workspace"
           style="-fx-font-size: 24;
                  -fx-font-weight: bold;"/>

    <!-- Scrollable flex dashboard -->
    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                style="-fx-background-color: transparent;">

        <VBox spacing="30">

            <VBox fx:id="deviceListContainer"
                  spacing="12">
                <Label text="Devices"
                       style="
                   -fx-font-size: 18px;
                   -fx-font-weight: bold;
                   -fx-text-fill: #1f2937;
               "/>
            </VBox>
            <!-- GRAPH SECTION -->
            <FlowPane fx:id="graphContainer"
                      hgap="20"
                      vgap="20"
                      prefWrapLength="900">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
            </FlowPane>

            <!-- DEVICE LIST SECTION -->


            <!-- FUTURE SECTION -->
            <!--            <VBox fx:id="xContainer"-->
            <!--                  spacing="12"/>-->

        </VBox>

    </ScrollPane>

</VBox>
