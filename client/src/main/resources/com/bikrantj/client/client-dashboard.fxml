<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/21"
            fx:controller="com.bikrantj.client.controllers.ClientDashboardController"
            style="-fx-background-color: #f8f9fc;">

    <!-- Top bar -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              style="-fx-background-color: white;
                     -fx-border-color: #e2e8f0;
                     -fx-border-width: 0 0 1 0;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>

            <Label text="Client Dashboard"
                   style="-fx-font-size: 24;
                          -fx-font-weight: bold;
                          -fx-text-fill: #1e293b;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Logout"
                    onAction="#onLogoutClicked"
                    prefHeight="38"
                    style="-fx-background-color: transparent;
                           -fx-border-color: #ef4444;
                           -fx-border-radius: 8;
                           -fx-text-fill: #ef4444;
                           -fx-font-size: 14;
                           -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- Main content area -->
    <center>
        <VBox alignment="CENTER"
              spacing="12"
              style="-fx-background-color: #f8f9fc;">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <Label text="Client is connected and running"
                   style="-fx-font-size: 18;
                          -fx-text-fill: #334155;
                          -fx-font-weight: bold;"/>

            <Label text="Activity and data sent to the server will appear here."
                   style="-fx-font-size: 14;
                          -fx-text-fill: #64748b;"/>
        </VBox>
    </center>

</BorderPane>
