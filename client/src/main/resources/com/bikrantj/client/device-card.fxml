<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.bikrantj.client.controllers.DeviceCardController"
      spacing="8" fx:id="root"
      maxWidth="Infinity"
      prefWidth="420"
      style="
          -fx-background-color: #ffffff;
          -fx-background-radius: 14;
          -fx-border-radius: 14;
          -fx-border-color: #e5e7eb;
          -fx-border-width: 1;
          -fx-cursor: hand;
          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0.1, 0, 2);
      ">

    <padding>
        <Insets top="14" right="16" bottom="14" left="16"/>
    </padding>

    <!-- Top row: Device name + status -->
    <HBox alignment="CENTER_LEFT" spacing="10">

        <Label fx:id="nameLabel"
               text="Device Name"
               style="
                   -fx-font-size: 15px;
                   -fx-font-weight: bold;
                   -fx-text-fill: #111827;
               "/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Status chip -->
        <Label fx:id="statusLabel"
               text="ONLINE"
               style="
                   -fx-background-color: #dcfce7;
                   -fx-text-fill: #166534;
                   -fx-font-size: 11px;
                   -fx-font-weight: bold;
                   -fx-background-radius: 999;
                   -fx-border-radius: 999;
                   -fx-padding: 4 10 4 10;
               "/>
    </HBox>

    <!-- OS Info -->
    <Label fx:id="osLabel"
           text="Windows 11 · x64"
           wrapText="true"
           style="
               -fx-font-size: 12.5px;
               -fx-text-fill: #4b5563;
           "/>

</VBox>
